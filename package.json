{
  "name": "pi-architecture-watcher",
  "version": "0.1.0",
  "description": "Static Vertical Slice Architecture (VSA) monitor for the Pi coding agent. Detects slice violations while files are edited, scores how far the code has drifted, and either auto-suggests fixes or pauses for human review.",
  "type": "module",
  "license": "MIT",
  "author": "mastnacek",
  "homepage": "https://github.com/mastnacek/pi-architecture-watcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastnacek/pi-architecture-watcher.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "vertical-slice-architecture",
    "vsa",
    "architecture",
    "static-analysis",
    "lsp",
    "architecture-guardian"
  ],
  "files": [
    "index.ts",
    "src",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}
